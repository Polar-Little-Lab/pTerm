{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pTerm",
  "version": "1.1.3",
  "identifier": "dev.harbor.ssh",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "pTerm",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Transparent",
        "backgroundColor": "#e7eff6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
